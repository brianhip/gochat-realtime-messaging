# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017

# Server Configuration
PORT=8080

# JWT Secret used to sign and verify auth tokens.
# Required — the server will refuse to start without this set.
# Must be at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Comma-separated list of frontend origins allowed to call the API (CORS)
# and open WebSocket connections.
# Defaults to http://localhost:3000 if unset.
ALLOWED_ORIGINS=http://localhost:3000

# Example for MongoDB Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/gochat
